# ── 内置 Python 运行时（约 165 MB，打包产物，不进仓库）──────────────
/runtime/
*.exe

# ── 运行期数据：数据库、WAL 日志、会话签名密钥 ──────────────────────
/app/data/*
!/app/data/.gitkeep
/app/backend/data/
*.db
*.db-wal
*.db-shm
*.key
*.log

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ── 编辑器 / 系统 ────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
